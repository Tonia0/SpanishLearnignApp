<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="521.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.andrei.sample_project.HelloController">
   <children>
      <TableView fx:id="table" layoutX="83.0" layoutY="14.0" prefHeight="377.0" prefWidth="548.0">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy></TableView>
      <Button fx:id="editButton" layoutX="108.0" layoutY="445.0" mnemonicParsing="false" onAction="#onEdit" prefWidth="110.0" text="Edit " />
      <Button fx:id="removeButton" layoutX="108.0" layoutY="482.0" mnemonicParsing="false" onAction="#onDelete" prefWidth="110.0" text="Remove " />
      <Button fx:id="createButton" layoutX="108.0" layoutY="413.0" mnemonicParsing="false" onAction="#onCreate" prefWidth="110.0" text="Create " />
      <TextField fx:id="firstNameInput" layoutX="376.0" layoutY="413.0" />
      <Label layoutX="304.0" layoutY="417.0" text="First name:" />
      <Label layoutX="333.0" layoutY="474.0" text="Age:" />
      <TextField fx:id="lastNameInput" layoutX="376.0" layoutY="441.0" />
      <Label layoutX="305.0" layoutY="445.0" text="Last name:" />
      <TextField fx:id="ageInput" layoutX="376.0" layoutY="470.0" />
      <AnchorPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
   </children>
</AnchorPane>
